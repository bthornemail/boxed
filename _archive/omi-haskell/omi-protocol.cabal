cabal-version: 3.0
name: omi-protocol
version: 0.1.0.0
build-type: Simple

library
  exposed-modules:
    OMI.Kernel
    OMI.Relation
    OMI.Delta
    OMI.Handler
    OMI.Pipeline
  build-depends:
    base >= 4.14 && < 5
  default-language: Haskell2010

executable omi-protocol
  main-is: Main.hs
  build-depends:
    base >= 4.14 && < 5,
    omi-protocol
  default-language: Haskell2010
